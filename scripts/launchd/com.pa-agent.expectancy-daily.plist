<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pa-agent.expectancy-daily</string>

  <!-- 每 6 小时跑一次正期望日检, 台账落在 logs/daily_check.tsv。
       安装脚本把 __REPO__ 替换成仓库根, __BASH__ 替换成用户路径上的 bash 副本。
       为什么不用 /bin/bash: 它在只读系统卷(SSV)上, macOS 的 TCC 拒绝把它登记进
       "完全磁盘访问权限"(实测点选后 TCC.db 里连 bash 条目都没有), 于是 launchd
       拉起的 bash 读不了 ~/Documents 下的仓库(exit 126)。 -->
  <key>ProgramArguments</key>
  <array>
    <string>__PY__</string>
    <string>__REPO__/scripts/daily_check.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>10</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- 日志不能落在 __REPO__/logs: 仓库在 ~/Documents 下, 受 macOS TCC 保护。
       launchd 在 bootstrap 时就要打开这两个文件, 打不开会直接报
       "Bootstrap failed: 5: Input/output error"(2026-09-20 实测), 任务根本装不上。
       放 ~/Library/Logs 是 LaunchAgent 的常规位置, 不受 TCC 约束。 -->
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/pa-agent-daily.out</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/pa-agent-daily.err</string>
</dict>
</plist>
